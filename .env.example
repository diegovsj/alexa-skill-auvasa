# =============================================================================
# Plantilla de variables de entorno de la skill AUVASA
# =============================================================================
# Copia este fichero a `.env` y rellena lo que necesites:
#
#     cp .env.example .env
#
# `.env` NO se sube a Git (está en .gitignore). En producción (AWS Lambda /
# Alexa-hosted) estas variables se configuran en la consola, no con este
# fichero.
#
# Las herramientas del repositorio (simulador, generador de datos) cargan
# automáticamente el `.env`. Todas las variables tienen un valor por defecto
# razonable, así que para desarrollo local basta con no tocar nada.
# =============================================================================

# -----------------------------------------------------------------------------
# Fuentes de datos (AUVASA)
# -----------------------------------------------------------------------------
# GTFS estático oficial (ZIP). Solo lo usa `npm run datos`.
AUVASA_GTFS_URL=http://212.170.201.204:50080/GTFSRTapi/api/GTFSFile

# Feed GTFS-Realtime de paso de autobuses (protobuf). Lo consulta la Lambda.
AUVASA_RT_URL=http://212.170.201.204:50080/GTFSRTapi/api/tripupdate

# Caché en memoria del feed en tiempo real (ms) y tiempo máximo de espera (ms).
AUVASA_RT_TTL_MS=20000
AUVASA_RT_TIMEOUT_MS=4000
# Si un intento falla, no se vuelve a intentar hasta que pasen estos ms.
AUVASA_RT_BACKOFF_MS=30000

# Ponlo a 1 para desactivar por completo el tiempo real (tests, sin red).
# AUVASA_RT_DISABLED=1

# -----------------------------------------------------------------------------
# Comportamiento
# -----------------------------------------------------------------------------
# Zona horaria de referencia para los horarios.
AUVASA_TZ=Europe/Madrid

# Fija el instante "actual" (ISO 8601). Útil para pruebas y demostraciones:
#   AUVASA_REFERENCIA=2026-11-10T07:00:00.000Z
# AUVASA_REFERENCIA=

# Nombre de invocación del modelo de voz (debe empezar por letra).
AUVASA_INVOCATION_NAME=bus valladolid

# Locales para los que generar iconos y modelo: "es-ES" o "es-ES,es-MX,es-US".
AUVASA_LOCALES=es-ES

# Caducidad de los datos persistentes en DynamoDB (segundos; 0 = sin caducidad).
AUVASA_TTL_SEGUNDOS=0

# -----------------------------------------------------------------------------
# Persistencia de la parada favorita (DynamoDB)
# -----------------------------------------------------------------------------
# Alexa-hosted define DYNAMODB_TABLE automáticamente. En local puedes dejarlo
# vacío: la skill usará un adaptador en memoria.
# DYNAMODB_TABLE=

# -----------------------------------------------------------------------------
# Credenciales de AWS (para `ask deploy` de una Lambda propia o DynamoDB local)
# -----------------------------------------------------------------------------
# Con Alexa-hosted NO hacen falta: la CLI usa el token de tu cuenta de
# desarrollador. Rellena solo si despliegas en tu propia cuenta de AWS.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=eu-west-1
